[sub_resource type="GDScript" id="GDScript_imhc6"]
resource_name = "cabinet_door"
script/source = "extends StaticBody3D

@onready var animation_player: AnimationPlayer = $\"../../../AnimationPlayer\"
@onready var audio_stream_player_3d: AudioStreamPlayer3D = $\"../../../AudioStreamPlayer3D\"

var is_open : bool = false

func open(player):
	if GameManager.has_cabinet_key and GameManager.is_on_past:
		animation_player.play(\"open\")
		audio_stream_player_3d.play()
		await get_tree().create_timer(1.5).timeout
		audio_stream_player_3d.stop()
		is_open = true
	elif GameManager.has_cabinet_key and !GameManager.is_on_past:
		player.feedback.exibir_texto_digitado(\"The key won't open it, it's rusty\")

func close(player):
	if GameManager.has_cabinet_key and GameManager.is_on_past:
		animation_player.play_backwards(\"open\")
		audio_stream_player_3d.play(1.5)
		await get_tree().create_timer(1.5).timeout
		audio_stream_player_3d.stop()
		is_open = false
"

