[sub_resource type="GDScript" id="GDScript_cyams"]
resource_name = "pc_control"
script/source = "extends Control

@onready var button_doc: Button = $HBoxContainer/VBoxContainer/ButtonDoc
@onready var button_pass: Button = $HBoxContainer/VBoxContainer2/ButtonPass
@onready var panel_container: PanelContainer = $PanelContainer
@onready var x_button: TextureButton = $TextureButton
@onready var panel_container_text: RichTextLabel = $PanelContainer/HBoxContainer/MarginContainer/RichTextLabel2
@onready var button_new_pass: Button = $HBoxContainer/VBoxContainer3/ButtonNewPass
@onready var v_box_container_3: VBoxContainer = $HBoxContainer/VBoxContainer3
#@onready var audio_stream_player_3d: AudioStreamPlayer3D = $\"../AudioStreamPlayer3D\"

var password = \"\"
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	if !GameManager.is_on_past and GameManager.has_energy:
		v_box_container_3.visible = true
	else:
		v_box_container_3.visible = false


func _on_x_button_pressed() -> void:
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	panel_container.visible = false
	x_button.disabled = true
	x_button.visible = false

#fazer a funcao para o app de senha que vai abrir o armario
func _on_button_doc_pressed() -> void:
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	panel_container.visible = true
	x_button.disabled = false
	x_button.visible = true
	panel_container_text.text = \"[center]Documents[/center]

Section 
_ _ _ E\"


func _on_button_pass_pressed() -> void:
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	panel_container.visible = true
	x_button.disabled = false
	x_button.visible = true
	panel_container_text.text = \"[center]Password[/center]

Changes in the password
Sorry for that, but we have to change the panel password, I hope you don't lock yourself in the room...
We'll send the new password in a few minutes.\"


func _on_button_new_pass_pressed() -> void:
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	panel_container.visible = true
	x_button.disabled = false
	x_button.visible = true
	panel_container_text.text = \"[center]Password[/center]

We really sorry for that.
Here's the new PASSWORD: {password}\".format({\"password\":password})
"

