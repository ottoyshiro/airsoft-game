[sub_resource type="GDScript" id="GDScript_x3dnt"]
resource_name = "pc"
script/source = "extends StaticBody3D

@onready var animation_player: AnimationPlayer = $\"../AnimationPlayer\"
@onready var camera_3d: Camera3D = $\"../Camera3D\"
@onready var control: Control = $\"../Control\"
@onready var mesh_instance_3d: MeshInstance3D = $\"../MeshInstance3D\"
#@onready var audio_stream_player_3d: AudioStreamPlayer3D = $\"../AudioStreamPlayer3D\"

var pc_texture = preload(\"res://Assets/Images/bd764bb25d49a05105060185774ba14cd2c846f7.jpg\")
var material_screen = null
var player = null

func _ready() -> void:
	material_screen = mesh_instance_3d.get_surface_override_material(0)
	if !GameManager.is_on_past:
		material_screen.albedo_texture = null
		#material_screen.albedo_color = Color(0,0,0)
		self.remove_from_group(\"Interactable\")
	else:
		self.add_to_group(\"Interactable\")
		material_screen.albedo_texture = pc_texture
		#material_screen.albedo_color = Color(255, 255, 255)
	control.visible = false

func _process(_delta: float) -> void:
	material_screen = mesh_instance_3d.get_surface_override_material(0)
	if GameManager.has_energy and !GameManager.is_on_past:
		self.add_to_group(\"Interactable\")
		material_screen.albedo_texture = pc_texture
		#material_screen.albedo_color = Color(255, 255, 255)
	elif !GameManager.has_energy and !GameManager.is_on_past:
		self.remove_from_group(\"Interactable\")
		material_screen.albedo_texture = null
	elif GameManager.is_on_past:
		self.add_to_group(\"Interactable\")
		material_screen.albedo_texture = pc_texture
		#material_screen.albedo_color = Color(255, 255, 255)


func acess_pc(player):
	self.player = player
	player.locked_controls = true
	camera_3d.current = true
	if player.held_item != null:
		player.held_items[player.held_item.item_id].visible = false
	animation_player.play(\"acess_pc\")
	await get_tree().create_timer(1).timeout
	player.crosshair.visible = false
	control.visible = true
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	Input.set_custom_mouse_cursor(preload(\"res://Assets/Images/cursor.png\"))
	player.mouse_view = true
	player.texture.material.set_shader_parameter(
		\"quantize_size\",
		 1)

func access_pc_present(player):
	if !GameManager.is_on_past and GameManager.has_energy:
		acess_pc(player)

func exit_pc(player):
	player.locked_controls = false
	camera_3d.current = false
	if player.held_item != null:
		player.held_items[player.held_item.item_id].visible = true
	player.crosshair.visible = true
	control.visible = false
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	Input.set_custom_mouse_cursor(null)
	player.mouse_view = false
	player.texture.material.set_shader_parameter(
		\"quantize_size\",
		 3)


func _on_button_pressed() -> void:
	exit_pc(player)
"

