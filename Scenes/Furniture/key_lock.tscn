[sub_resource type="GDScript" id="GDScript_mwyaa"]
resource_name = "terminal"
script/source = "extends StaticBody3D

@onready var camera_3d: Camera3D = $\"../Camera3D\"
@onready var display: CSGBox3D = $\"../CSGBox3D/display\"

var on_display : bool = false
var player = null

func _ready() -> void:
	camera_3d.current = false

func set_player(player):
	display.player = player

func anim_handler_terminal(player):
	set_player(player)
	player.camera.current = false
	self.camera_3d.current = true
	#camera_3d.visible = true
	self.input_ray_pickable = false
	on_display = true
	player.locked_controls = true
	player.crosshair.visible = false
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	player.mouse_view = true

func exit(player):
		player.locked_controls = false
		player.crosshair.visible = true
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
		self.camera_3d.current = false
		self.on_display = false
		player.mouse_view = false
		await get_tree().create_timer(0.5).timeout
		#self.remove_from_group(\"Interactable\")
"

