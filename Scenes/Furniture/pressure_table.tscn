[sub_resource type="GDScript" id="GDScript_mjdt6"]
resource_name = "cube_spot"
script/source = "extends StaticBody3D


@onready var cube_view: Node3D = $\"../../CubeView\"
@onready var collision_shape_3d: CollisionShape3D = $CollisionShape3D
@onready var table_btn: StaticBody3D = $\"../../CSGBox3D4/StaticBody3D\"
@onready var animation_player: AnimationPlayer = $\"../../CSGBox3D4/StaticBody3D/AnimationPlayer\"
@onready var table: StaticBody3D = $\"../../CSGBox3D5/StaticBody3D\"
@onready var audio_stream_player_3d: AudioStreamPlayer3D = $\"../../AudioStreamPlayer3D\"

var cube_instance = null
var activated : bool = false

func _ready() -> void:
	self.add_to_group(\"Interactable\")
	self.visible = false
	collision_shape_3d.disabled = true

func get_cube_instance(cube_instance):
	self.cube_instance = cube_instance

func set_activated(activated):
	self.activated = activated

func pick_cube(player):
	audio_stream_player_3d.play()
	if player.held_item == null:
		if cube_instance.can_be_picked or GameManager.has_gloves:
			if !activated:
				player.held_item = cube_instance
				player.held_items[player.held_item.item_id].visible = true
				self.visible = false
				collision_shape_3d.disabled = true
				GameManager.has_cube = true
				table.cube_placed = false
				cube_view.visible = false
				table.cube_placed = false
				table.table_btn.set_cube_placed(table.cube_placed)
				return
		print(\"vai queimar tu mao\")
		return
	print(\"voce ja tem um item\")
	#self.remove_from_group(\"Interactable\")
	
"

