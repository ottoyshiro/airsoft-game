[sub_resource type="GDScript" id="GDScript_3lvf6"]
resource_name = "table_press"
script/source = "extends StaticBody3D


@onready var cube_view: Node3D = $\"../../CubeView\"
@onready var animation_player: AnimationPlayer = $\"../../CSGBox3D4/StaticBody3D/AnimationPlayer\"
@onready var camera_3d: Camera3D = $\"../../CSGBox3D4/StaticBody3D/Camera3D\"
@onready var table_btn: StaticBody3D = $\"../../CSGBox3D4/StaticBody3D\"
#@onready var collision_shape_3d: CollisionShape3D = $\"../Cube_spot/CollisionShape3D\"
@onready var cube_spot: StaticBody3D = $\"../../CSGBox3D3/Cube_spot\"
@onready var collision_shape_3d: CollisionShape3D = $\"../../CSGBox3D3/Cube_spot/CollisionShape3D\"
@onready var audio_stream_player_3d: AudioStreamPlayer3D = $\"../../AudioStreamPlayer3D\"

var cube_placed : bool = false
var cube_instance = null

func _ready() -> void:
	self.add_to_group(\"Interactable\")
	cube_spot.visible = false
	#collision_shape_3d.disabled = true

func anim_handler(player):
	audio_stream_player_3d.play()
	camera_3d.current = true
	player.locked_controls = true
	if GameManager.has_cube and !cube_placed:
		player.held_items[player.held_item.item_id].visible = false
		#player.held_item.queue_free()
		cube_instance = player.held_item
		player.crosshair.visible = false
		player.held_item = null
		animation_player.play(\"insert_cube\")
		player.locked_controls = true
		cube_placed = true
		table_btn.set_cube_placed(cube_placed)
		await get_tree().create_timer(1).timeout
		player.locked_controls = false
		GameManager.has_cube = false
		player.crosshair.visible = true
		#self.remove_from_group(\"Interactable\")
		cube_spot.get_cube_instance(cube_instance)
		cube_spot.add_to_group(\"Interactable\")
		cube_spot.visible = true
		cube_spot.get_child(0).disabled = false
		#collision_shape_3d.disabled = false
	#if Input.is_action_just_pressed(\"left_click\") and cube_placed:
		#player.held_items[player.held_item.item_id].visible = true
		#player.held_item = cube_instance
		#cube_placed = false
		#player.locked_controls = false
	
	player.locked_controls = false
	camera_3d.current = false
"

