size = Vector3(0.20220947, 0.4, 0.20672607)

[sub_resource type="GDScript" id="GDScript_uyo03"]
resource_name = "table_press_btn"
script/source = "extends StaticBody3D

@onready var animation_player: AnimationPlayer = $AnimationPlayer
@onready var camera_3d: Camera3D = $Camera3D
@onready var cube_view: Node3D = $\"../../CubeView\"
@onready var cube_spot: StaticBody3D = $\"../../CSGBox3D3/Cube_spot\"
@onready var pressure_table: Node3D = $\"../..\"
@onready var audio_stream_player_3d_2: AudioStreamPlayer3D = $\"../../AudioStreamPlayer3D2\"

var cube_placed : bool = false
var cube_instance = null
var activated : bool = false

func _ready() -> void:
	self.add_to_group(\"Interactable\")

func set_cube_placed(cube_placed):
	self.cube_placed = cube_placed

func anim_handler(player):
	camera_3d.current = true
	player.crosshair.visible = false
	player.locked_controls = true
	audio_stream_player_3d_2.play(0.08)
	await get_tree().create_timer(0.09).timeout
	audio_stream_player_3d_2.stop()
	if cube_placed and !activated:
		#if player.held_items != null:
			#player.held_items[player.held_item.item_id].visible = false
		cube_view.visible = true
		player.locked_controls = true
		animation_player.play(\"activating_plate\")
		await get_tree().create_timer(1).timeout
		player.locked_controls = false
		activated = true
		cube_spot.set_activated(activated)
		pressure_table.unlocked = true
		#camera_3d.current = false
		await pressure_table.run_anim()
		player.crosshair.visible = true
		return
	animation_player.play(\"press_btn\")
	if !cube_placed:
		animation_player.play(\"activating_plate\")
		await get_tree().create_timer(1).timeout
		animation_player.play_backwards(\"activating_plate\")
		await get_tree().create_timer(1).timeout
		player.locked_controls = false
		player.camera.current = true
		player.crosshair.visible = true
		player.feedback.exibir_texto_digitado(\"I need to put something into that\")
		return
	if activated:
		animation_player.play_backwards(\"activating_plate\")
		await get_tree().create_timer(1).timeout
		#cube_view.visible = false
		activated = false
		pressure_table.unlocked = false
		#camera_3d.current = false
		cube_spot.set_activated(activated)
		await pressure_table.run_anim()
		player.crosshair.visible = true
		
	player.locked_controls = false
	camera_3d.current = false
	player.crosshair.visible = true
	player.camera.current = true
"

