[sub_resource type="GDScript" id="GDScript_he3po"]
resource_name = "placeholder_cupule"
script/source = "extends StaticBody3D

@onready var cube_view: Node3D = $\"../CubeView\"
@onready var camera_3d: Camera3D = $\"../Camera3D\"
@onready var animation_player: AnimationPlayer = $\"../AnimationPlayer\"
@onready var camera_3d_2: Camera3D = $\"../Camera3D2\"
@onready var fuse: RigidBody3D = $\"../Node3D/fuse\"
@onready var mesh_instance_3d: MeshInstance3D = $\"../CSGBox3D/MeshInstance3D\"
@onready var button: StaticBody3D = $\"../CSGBox3D16/StaticBody3D\"
@onready var audio_stream_player_3d: AudioStreamPlayer3D = $\"../AudioStreamPlayer3D\"
@onready var audio_stream_player_3d_3: AudioStreamPlayer3D = $\"../AudioStreamPlayer3D3\"

var cube_instance
var is_opened_side : bool = false

func _ready() -> void:
	fuse.remove_from_group(\"Interactable\")
	if !GameManager.is_on_past:
		self.remove_from_group(\"Interactable\")
		return
	self.add_to_group(\"Interactable\")

func _process(_delta: float) -> void:
	if !GameManager.is_on_past:
		self.remove_from_group(\"Interactable\")
		mesh_instance_3d.mesh.text = \"ERROR!\"

		return
	self.add_to_group(\"Interactable\")
	mesh_instance_3d.mesh.text = \"Energy required\"

func anim_handler(player):
	if GameManager.has_cube and GameManager.has_gloves and GameManager.is_on_past:
		player.locked_controls = true
		player.crosshair.visible = false
		camera_3d.current = true
		cube_view.visible = true
		player.held_items[player.held_item.item_id].visible = false
		player.held_item = null
		GameManager.has_cube = false
		animation_player.play_backwards(\"open\")
		await get_tree().create_timer(1).timeout
		audio_stream_player_3d.play(1)
		await get_tree().create_timer(1).timeout
		audio_stream_player_3d.stop()
		await get_tree().create_timer(2).timeout
		camera_3d.current = false
		camera_3d_2.current = true
		animation_player.play(\"open_side\")
		audio_stream_player_3d_3.play()
		await get_tree().create_timer(1).timeout
		audio_stream_player_3d_3.stop()
		await get_tree().create_timer(2).timeout
		fuse.add_to_group(\"Interactable\")
		player.locked_controls = false
		camera_3d.current = false
		camera_3d_2.current = false
		player.crosshair.visible = true
		is_opened_side = true
		button.remove_from_group(\"Interactable\")
		return
"

