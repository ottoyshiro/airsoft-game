[sub_resource type="GDScript" id="GDScript_j7hp6"]
resource_name = "cupule_btn"
script/source = "extends StaticBody3D

@onready var animation_player: AnimationPlayer = $\"../../AnimationPlayer\"
@onready var camera_3d: Camera3D = $\"../../Camera3D\"
@onready var audio_stream_player_3d: AudioStreamPlayer3D = $\"../../AudioStreamPlayer3D\"
@onready var audio_stream_player_3d_2: AudioStreamPlayer3D = $\"../../AudioStreamPlayer3D2\"
@onready var static_body_3d: StaticBody3D = $\"../../StaticBody3D\"

var cube_placed : bool = false
var cube_instance = null
var is_opened : bool = false

func _ready() -> void:
	if !GameManager.is_on_past:
		self.remove_from_group(\"Interactable\")
		return
		self.add_to_group(\"Interactable\")

func _process(_delta: float) -> void:
	if !GameManager.is_on_past:
		self.remove_from_group(\"Interactable\")
		return
	if !static_body_3d.is_opened_side:
		self.add_to_group(\"Interactable\")

func anim_handler(player):
	if !is_opened:
		player.locked_controls = true
		camera_3d.current = true
		player.crosshair.visible = false
		if player.held_item != null:
			player.held_items[player.held_item.item_id].visible = false
		animation_player.play(\"press_btn\")
		audio_stream_player_3d_2.play(0.08)
		await get_tree().create_timer(0.09).timeout
		audio_stream_player_3d_2.stop()
		await get_tree().create_timer(1).timeout
		animation_player.play(\"open\")
		audio_stream_player_3d.play(1)
		await get_tree().create_timer(1).timeout
		audio_stream_player_3d.stop()
		await get_tree().create_timer(2).timeout
		if !GameManager.has_cube and GameManager.is_on_past:
			player.feedback.exibir_texto_digitado(\"I'll need a energized cube first\")
		player.locked_controls = false
		player.crosshair.visible = true
		camera_3d.current = false
		is_opened = true
	else:
		player.locked_controls = true
		camera_3d.current = true
		player.crosshair.visible = false
		if player.held_item != null:
			player.held_items[player.held_item.item_id].visible = false
		animation_player.play(\"press_btn\")
		await get_tree().create_timer(1).timeout
		animation_player.play_backwards(\"open\")
		await get_tree().create_timer(1).timeout
		audio_stream_player_3d.play(1)
		await get_tree().create_timer(1).timeout
		audio_stream_player_3d.stop()
		await get_tree().create_timer(2).timeout
		player.locked_controls = false
		player.crosshair.visible = true
		camera_3d.current = false
		is_opened = false
	if player.held_item != null:
		player.held_items[player.held_item.item_id].visible = true
"

