[sub_resource type="GDScript" id="GDScript_3uywc"]
resource_name = "electric_door"
script/source = "extends StaticBody3D

@onready var animation_player: AnimationPlayer = $AnimationPlayer
@onready var camera_3d_3: Camera3D = $\"../../Camera3D3\"
@onready var audio_stream_player_3d: AudioStreamPlayer3D = $\"../../AudioStreamPlayer3D\"
@onready var audio_stream_player_3d_2: AudioStreamPlayer3D = $\"../../AudioStreamPlayer3D2\"

var unlocked_by : int
var anim_finish : bool
func _ready() -> void:
	camera_3d_3.current = false

func run_anim(player):
	#self.get_parent().get_parent().unlocked_by = unlocked_by
	#animation_player.play(type)
	#if GameManager.has_screwdriver:
		#animation_player.play(\"screws\")
		#GameManager.has_screwdriver = false
		#GameManager.has_screws = false
		#return
	#if not GameManager.has_screws:
			#await get_tree().create_timer(1.5).timeout
		#animation_player.play(\"compartment\")
		#GameManager.has_screws = true
		#return
	if GameManager.terminal_password and !anim_finish:
		player.crosshair.visible = false
		animation_player.play(\"unlock\")
		anim_finish = true
		audio_stream_player_3d.play()
		await get_tree().create_timer(0.5).timeout
		audio_stream_player_3d.stop()
		await get_tree().create_timer(3).timeout
		GameManager.unlocked = true
		player.crosshair.visible = true
		
		return
	if GameManager.terminal_password and GameManager.unlocked:
		animation_player.play(\"open\")
		GameManager.unlocked = false
		audio_stream_player_3d_2.play()
		await get_tree().create_timer(1).timeout
		audio_stream_player_3d_2.stop()
		GameManager.terminal_password = false
		player.camera.current = true
		return
"

