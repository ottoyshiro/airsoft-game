[sub_resource type="GDScript" id="GDScript_dbspq"]
resource_name = "final_lock_control"
script/source = "extends Control

@onready var item : PackedScene = preload(\"res://Scenes/Items/key.tscn\")

@onready var letter_spot: MeshInstance3D = $\"../letter_spot\"
@onready var letter_spot_2: MeshInstance3D = $\"../letter_spot2\"
@onready var letter_spot_3: MeshInstance3D = $\"../letter_spot3\"
@onready var letter_spot_4: MeshInstance3D = $\"../letter_spot4\"
@onready var slide_arrow: TextureButton = $HBoxContainer2/slide_arrow
@onready var slide_arrow_2: TextureButton = $HBoxContainer2/slide_arrow2
@onready var slide_arrow_3: TextureButton = $HBoxContainer2/slide_arrow3
@onready var slide_arrow_4: TextureButton = $HBoxContainer2/slide_arrow4
@onready var animation_player: AnimationPlayer = $\"../AnimationPlayer\"
@onready var static_body_3d: StaticBody3D = $\"../StaticBody3D\"
@onready var item_spot: Node3D = $\"../Node3D2\"

var code = \"CDAE\"
var alphabet_list : Array = [\"A\", \"B\", \"C\", \"D\", \"E\", \"F\"]
var answer = \"\"
var i = 0
var i_2 = 0
var i_3 = 0
var i_4 = 0
var is_answer_correct : bool = false
var locked_anim : bool = false

func _ready() -> void:
	self.visible = false
	letter_spot.mesh.text = \"X\"
	letter_spot_2.mesh.text = \"X\"
	letter_spot_3.mesh.text = \"X\"
	letter_spot_4.mesh.text = \"X\"
	answer = letter_spot.mesh.text + letter_spot_2.mesh.text + letter_spot_3.mesh.text + letter_spot_4.mesh.text

func _process(_delta: float) -> void:
	answer = letter_spot.mesh.text + letter_spot_2.mesh.text + letter_spot_3.mesh.text + letter_spot_4.mesh.text
	if answer == code:
		self.visible = false
		is_answer_correct = true
		if is_answer_correct and !locked_anim:
			locked_anim = true
			animation_player.play(\"open\")
			await get_tree().create_timer(1).timeout
			static_body_3d.remove_from_group(\"Interactable\")
			static_body_3d.get_child(0).disabled = true
			var key = item.instantiate()
			item_spot.add_child(key)

func _on_slide_arrow_pressed() -> void:
	letter_spot.mesh.text = alphabet_list[i]
	i += 1
	if i == 6:
		i = 0


func _on_slide_arrow_2_pressed() -> void:
	letter_spot_2.mesh.text = alphabet_list[i_2]
	i_2 += 1
	if i_2 == 6:
		i_2 = 0


func _on_slide_arrow_3_pressed() -> void:
	letter_spot_3.mesh.text = alphabet_list[i_3]
	i_3 += 1
	if i_3 == 6:
		i_3 = 0


func _on_slide_arrow_4_pressed() -> void:
	letter_spot_4.mesh.text = alphabet_list[i_4]
	i_4 += 1
	if i_4 == 6:
		i_4 = 0
"

