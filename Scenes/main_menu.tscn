[sub_resource type="GDScript" id="GDScript_16hvj"]
resource_name = "glitch"
script/source = "extends ColorRect

#@onready var control: Control = $\"../../crosshair/Control\"


func _ready() -> void:
	self.visible = false

func change():
	self.visible = true
	#control.visible = false
	await get_tree().create_timer(1).timeout
	self.visible = false
	#control.visible = true
"

[sub_resource type="GDScript" id="GDScript_n45e2"]
resource_name = "title"
script/source = "extends RichTextLabel

var original_text = \"Echo's Paradox\"

func glitch_text():
	var chars = \"!@#$%&*ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789\"

	var result = \"\"

	for i in original_text.length():
		if randf() < 0.2:
			result += chars[randi() % chars.length()]
		else:
			result += original_text[i]

	self.text = result

func restore_text():
	self.text = original_text
"

