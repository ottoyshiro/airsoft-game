[sub_resource type="GDScript" id="GDScript_1ehe0"]
resource_name = "main_menu"
script/source = "extends CanvasLayer

@onready var device_view: Node3D = $Node3D/device_view_menu
@onready var glitch: ColorRect = $UI/Glitch
@onready var flash: ColorRect = $UI/Flash
@onready var rich_text_label: RichTextLabel = $UI/RichTextLabel
@onready var audio_stream_player_3d: AudioStreamPlayer3D = $AudioStreamPlayer3D

func _ready():
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	audio_stream_player_3d.play()
	run_device_loop()
	run_title_loop()


func run_device_loop():
	while true:
		await get_tree().create_timer(1.0).timeout
		device_view.change_device()
		GameManager.is_on_past = !GameManager.is_on_past
		await glitch.change()
		await get_tree().create_timer(4.0).timeout

func run_title_loop():
	while true:
		await get_tree().create_timer(1.0).timeout
		# Alguns glitches rápidos
		for i in range(20):
			rich_text_label.glitch_text()
			await get_tree().create_timer(0.05).timeout

		# Volta ao normal
		rich_text_label.restore_text()

		# Fica legível por bastante tempo
		await get_tree().create_timer(4.0).timeout


func _on_start_pressed() -> void:
	GameManager.is_on_past = false
	GameManager.documents = [false, false, false, false]
	GameManager.has_prototype = false
	get_tree().change_scene_to_packed(load(\"res://Scenes/mvp_level.tscn\"))


func _on_quit_pressed() -> void:
	get_tree().quit()
"

