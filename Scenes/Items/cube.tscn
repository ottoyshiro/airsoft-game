[sub_resource type="GDScript" id="GDScript_1l1uf"]
resource_name = "cube"
script/source = "extends RigidBody3D

enum State {
	WORLD,
	HELD
}

@export var item_id: String

@onready var present_material : Array = [preload(\"res://Assets/Materials/Cube/cube.tres\")]
@onready var past_material : Array = [preload(\"res://Assets/Materials/Cube/cube_nt.tres\")]

@onready var mesh_instance_3d: MeshInstance3D = $MeshInstance3D

var state: State = State.WORLD
var owner_player = null
var last_safe_position: Vector3
var can_be_picked : bool = true

func _ready() -> void:
	if GameManager.is_on_past:
		mesh_instance_3d.set_surface_override_material(0, past_material[0])
	else:
		mesh_instance_3d.set_surface_override_material(0, present_material[0])

func change_material():
	if GameManager.is_on_past:
		mesh_instance_3d.set_surface_override_material(0, past_material[0])
	else:
		mesh_instance_3d.set_surface_override_material(0, present_material[0])

func _physics_process(_delta):
	change_material()
	if !GameManager.is_on_past:
		can_be_picked = true
	elif GameManager.is_on_past:
		can_be_picked = false
	if state == State.WORLD:
		track_safety()


func track_safety():
	# salva posição válida
	if linear_velocity.length() < 1.0:
		last_safe_position = global_position

	# caiu do mapa
	if global_position.y < -50:
		trigger_recovery(\"fell_out\")


func trigger_recovery(reason: String):
	print(\"Recovery:\", reason)

	if owner_player:
		owner_player.force_recover_item(self)
	else:
		respawn_at_safe_point()


func respawn_at_safe_point():
	global_position = last_safe_position + Vector3.UP * 1.0
	linear_velocity = Vector3.ZERO
	angular_velocity = Vector3.ZERO
"

