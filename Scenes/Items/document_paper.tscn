[sub_resource type="GDScript" id="GDScript_miejs"]
resource_name = "document"
script/source = "extends StaticBody3D

@onready var control: Control = $\"../Control\"
@onready var rich_text_label: RichTextLabel = $\"../Control/Panel/RichTextLabel\"
@onready var texture_button: TextureButton = $\"../Control/TextureButton\"
@onready var audio_stream_player_3d: AudioStreamPlayer3D = $\"../AudioStreamPlayer3D\"

var player_instance

func _ready() -> void:
	control.visible = false
	rich_text_label.text = self.get_parent().text

func set_player(player):
	self.player_instance = player

func pick_docs(player):
	audio_stream_player_3d.play()
	GameManager.documents[self.get_parent().type] = true
	GameManager.documents_text[self.get_parent().type] = self.get_parent().text
	self.set_player(player)
	self.get_parent().visible = false
	self.remove_from_group(\"Interactable\")
	player.locked_controls = true
	player.crosshair.visible = false
	if player.held_item != null:
		player.held_items[player.held_item.item_id].visible = false
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	player.texture.material.set_shader_parameter(
		\"quantize_size\",
		 1)
	control.visible = true
	
func exit_docs(player):
	player.locked_controls = false
	if player.held_item != null:
		player.held_items[player.held_item.item_id].visible = true
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	control.visible = false
	player.texture.material.set_shader_parameter(
		\"quantize_size\",
		 3)
	player.crosshair.visible = true


func _on_texture_button_pressed() -> void:
	exit_docs(player_instance)
	self.get_parent().queue_free()
"

