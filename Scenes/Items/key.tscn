[sub_resource type="GDScript" id="GDScript_ut0wq"]
resource_name = "key"
script/source = "extends RigidBody3D

enum State {
	WORLD,
	HELD
}
@export var item_id: String

@onready var present_material : Array = [preload(\"res://Assets/Materials/Key/key_jew.tres\"), preload(\"res://Assets/Materials/Key/key_body.tres\")]
@onready var past_material : Array = [preload(\"res://Assets/Materials/Key/key_jew_nt.tres\"), preload(\"res://Assets/Materials/Key/key_body_nt.tres\")]

@onready var cylinder_002: MeshInstance3D = $Cylinder_002
@onready var cube: MeshInstance3D = $Cube

var state: State = State.WORLD
var owner_player = null
var last_safe_position: Vector3

func _ready() -> void:
	if GameManager.is_on_past:
		cylinder_002.set_surface_override_material(0, past_material[0])
		cube.set_surface_override_material(0, past_material[1])
	else:
		cylinder_002.set_surface_override_material(0, present_material[0])
		cube.set_surface_override_material(0, present_material[1])

func change_material():
	if GameManager.is_on_past:
		cylinder_002.set_surface_override_material(0, past_material[0])
		cube.set_surface_override_material(0, past_material[1])
	else:
		cylinder_002.set_surface_override_material(0, present_material[0])
		cube.set_surface_override_material(0, present_material[1])

func _physics_process(_delta):
	if state == State.WORLD:
		track_safety()


func track_safety():
	# salva posição válida
	if linear_velocity.length() < 1.0:
		last_safe_position = global_position

	# caiu do mapa
	if global_position.y < -50:
		trigger_recovery(\"fell_out\")


func trigger_recovery(reason: String):
	print(\"Recovery:\", reason)

	if owner_player:
		owner_player.force_recover_item(self)
	else:
		respawn_at_safe_point()


func respawn_at_safe_point():
	global_position = last_safe_position + Vector3.UP * 1.0
	linear_velocity = Vector3.ZERO
	angular_velocity = Vector3.ZERO
"

