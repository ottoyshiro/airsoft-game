[sub_resource type="GDScript" id="GDScript_spfra"]
resource_name = "device_view_menu"
script/source = "extends Node3D

@onready var animation_player: AnimationPlayer = $AnimationPlayer
@onready var mesh_instance_3d: MeshInstance3D = $MeshInstance3D

var points: Array[Vector3] = []
var current_point := 0

var start_pos: Vector3
var time := 0.0


func _ready():

	for child in get_children():
		if child is Marker3D:
			points.append(child.global_position)

	if not points.is_empty():
		current_point = randi() % points.size()
		global_position = points[current_point]

	start_pos = global_position

	run_loop()


func _process(delta):

	time += delta

	global_position = start_pos + Vector3(
		sin(time * 0.3) * 0.5,
		cos(time * 0.2) * 0.3,
		sin(time * 0.15) * 0.4
	)

	rotation.y += delta * 0.2

	# Inclinação leve para parecer flutuando
	rotation.x = sin(time * 0.2) * 0.1
	rotation.z = cos(time * 0.15) * 0.1


func run_loop():

	if points.is_empty():
		return

	while true:

		await get_tree().create_timer(2.0).timeout

		var next_point := current_point

		while next_point == current_point and points.size() > 1:
			next_point = randi() % points.size()

		current_point = next_point

		start_pos = points[current_point]
		global_position = start_pos
		await get_tree().create_timer(4.0).timeout


func change_device():

	if GameManager.is_on_past:
		animation_player.play(\"to_present\")
	else:
		animation_player.play(\"to_past\")
"

