[sub_resource type="GDScript" id="GDScript_v0iea"]
resource_name = "crosshair"
script/source = "extends Control

var active = true #false

func set_active(value):
	active = value
	queue_redraw()

func _draw():
	var center = size / 2 + Vector2(6, 0)

	if active:
		draw_circle(center, 1, Color.WHITE) #6
	else:
		draw_arc(center, 1, 0, TAU, 32, Color.WHITE, 2)

func toggle_visibility():
	self.visible = !self.visible
"

