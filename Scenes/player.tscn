[sub_resource type="GDScript" id="GDScript_fkybt"]
resource_name = "glitch"
script/source = "extends ColorRect

@onready var control: Control = $\"../../crosshair/Control\"


func _ready() -> void:
	self.visible = false

func change():
	self.visible = true
	control.visible = false
	await get_tree().create_timer(1).timeout
	self.visible = false
	control.visible = true
"

[sub_resource type="GDScript" id="GDScript_f1ek2"]
resource_name = "feedback"
script/source = "extends RichTextLabel

# Tempo total em segundos para digitar todo o texto
@export var velocidade_digitacao: float = 2.0
@onready var audio_stream_player_3d_2: AudioStreamPlayer3D = $\"../../AudioStreamPlayer3D2\"

func exibir_texto_digitado(novo_texto: String):
	text = novo_texto
	visible_characters = 0

	audio_stream_player_3d_2.play()

	var tween = create_tween()
	tween.tween_property(
		self,
		\"visible_characters\",
		text.length(),
		velocidade_digitacao
	)

	await tween.finished

	audio_stream_player_3d_2.stop()
	await get_tree().create_timer(3).timeout
	self.text = \"\"
"

