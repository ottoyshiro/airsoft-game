resource_name = "player"
script/source = "extends CharacterBody3D


@export var SPEED = 5.0
@export var camera_sensibility : float = 0.005
@export var key_scene : PackedScene

@onready var camera_pivot : Node3D = $CameraPivot
@onready var camera : Camera3D = $CameraPivot/Camera3D
#@onready var camera_anim_player = $camera_animation
@onready var ray = $CameraPivot/Camera3D/RayCast3D
@onready var crosshair = $crosshair/Control
@onready var hold_position: Marker3D = $CameraPivot/Camera3D/HoldPosition
#@onready var key: RigidBody3D = $CameraPivot/Camera3D/HoldPosition/key
@onready var glitch: ColorRect = $UI/Glitch
@onready var animation_device: AnimationPlayer = $CameraPivot/Camera3D/AnimationPlayer
@onready var flash: ColorRect = $UI/Flash
@onready var device: Node3D = $CameraPivot/Camera3D/device_view
@onready var item_view_manager: Node3D = $CameraPivot/Camera3D/HoldPosition/item_view_manager
@onready var texture: ColorRect = $UI/Texture
@onready var feedback: RichTextLabel = $UI/RichTextLabel
@onready var final_screen: CanvasLayer = $FinalScreen
@onready var audio_stream_player_3d: AudioStreamPlayer3D = $AudioStreamPlayer3D
#@onready var arma = $CameraPivot/Camera3D/HoldPosition/item_view_manager/gun
@onready var label_controls: Label = $UI/Control/controls/Label
@onready var label_enemies: Label = $UI/Control/enemies/Label

@onready var botoes_carregadores = [
	$UI/Control/HBoxContainer/Button,
	$UI/Control/HBoxContainer/Button2,
	$UI/Control/HBoxContainer/Button3,
	$UI/Control/HBoxContainer/Button4
]
@onready var label: Label = $UI/Control/VBoxContainer/Label
@onready var progress_bar: Label = $UI/Control/VBoxContainer/ProgressBar

@onready var armas_view: Array[Node3D] = [
	$CameraPivot/Camera3D/HoldPosition/item_view_manager/gun_view,
	$CameraPivot/Camera3D/HoldPosition/item_view_manager/rifle_view,
	$CameraPivot/Camera3D/HoldPosition/item_view_manager/shotgun_view,
	$CameraPivot/Camera3D/HoldPosition/item_view_manager/pistoll_1911_view]
var arma_atual: Weapon
var shoot : bool = true

const JUMP_VELOCITY = 4.5
var is_crouching := false
var is_running := false
var mouse_input := Vector2.ZERO
var held_items = {}
var held_item = null
var current_item : RigidBody3D
var camera_pitch := 0.0
var locked_controls = false
var mouse_view : bool = false
var obj = null
var ui_open
var inventario_carregadores: Array = []


func check_interaction():
	if ray.is_colliding():
		obj = ray.get_collider()

		if obj is RigidBody3D and Input.is_action_just_pressed(\"left_click\"):
			if obj.item_id == \"cube\" and !GameManager.has_gloves and GameManager.is_on_past:
				feedback.exibir_texto_digitado(\"I need a pair of gloves\")
				print(\"preciso de luvas\")
				return
			pick_item(obj)

	if Input.is_action_just_pressed(\"right_click\"):
		drop_item()

func _ready():
	label_controls.text = \"1, 2, 3 - select items
						R - reload
						F - change mode SEMI/AUTO
						E - interact
						LMB - shoot
						SCROLL - hop up\"
	label_enemies.text = \"Enemies: \" + str(GameManager.enemies_defeated) + \" / \" + str(GameManager.total_enemies)
	#for arma in armas:
		#arma.visible = false
		#arma.ativa = false
#
		#if arma is Node3D and arma.get_script() != null:
			#if \"player\" in arma:
				#arma.player = self
#
	#if armas.size() > 0:
		#arma_atual = armas[indice_arma_atual]
		#arma_atual.visible = false
		#arma_atual.ativa = true
	arma_atual = $\"../gun\"
	arma_atual.player = self
	arma_atual.disable_collision()
	
	atualizar_visual_arma()
	atualizar_ui_inventario()
	#if arma_atual != null:
	label.text = WeaponTypes.nome_tipo(arma_atual.tipo_carregador)
	progress_bar.text = str(arma_atual.municao_atual) + \"/\" + str(arma_atual.municao_atual)
	arma_atual.player = self
	camera_pivot.get_child(0).play(\"stand\")
	held_items = {
		\"cabinet_key\": $CameraPivot/Camera3D/HoldPosition/item_view_manager/cabinet_key_view,
		\"key\": $CameraPivot/Camera3D/HoldPosition/item_view_manager/key_view,
		\"fuse\": $CameraPivot/Camera3D/HoldPosition/item_view_manager/fuse_view,
		\"cube\": $CameraPivot/Camera3D/HoldPosition/item_view_manager/cube_view
	}
	get_tree().paused = false
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	Input.use_accumulated_input = false

func _input(event):
	if !mouse_view:
		if event is InputEventMouseMotion:
			mouse_input += event.relative
		# recaptura mouse
		if event is InputEventMouseButton:
			if event.button_index == MOUSE_BUTTON_LEFT and event.pressed:

				if Input.mouse_mode == Input.MOUSE_MODE_VISIBLE:

					Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
					mouse_input = Vector2.ZERO
					
					if held_item != null:
						held_items[held_item.item_id].visible = false
						await get_tree().process_frame
						held_items[held_item.item_id].visible = true

func _process(_delta):
	if Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:
		# rotação horizontal
		camera_pivot.rotate_y(
			-mouse_input.x * camera_sensibility
		)
		# acumula pitch
		camera_pitch += -mouse_input.y * camera_sensibility
		# limita pitch
		camera_pitch = clamp(
			camera_pitch,
			deg_to_rad(-80),
			deg_to_rad(80)
		)
		# aplica pitch
		camera.rotation.x = camera_pitch

		mouse_input = Vector2.ZERO

func _unhandled_input(event: InputEvent) -> void:
	
	if event.is_action_pressed(\"select_magazine_1\"):
		selecionar_carregador(0)

	elif event.is_action_pressed(\"select_magazine_2\"):
		selecionar_carregador(1)

	elif event.is_action_pressed(\"select_magazine_3\"):
		selecionar_carregador(2)

	elif event.is_action_pressed(\"select_magazine_4\"):
		selecionar_carregador(3)
	if !shoot:
		print(\"you cant shoot here\")
		return
	if event.is_action_pressed(\"left_click\"):
		arma_atual.gatilho_pressionado = true

		if arma_atual.modo_disparo == arma_atual.ModoDisparo.SEMI:
			arma_atual.disparar_se_possivel()
			
	elif event.is_action_released(\"left_click\"):
		arma_atual.gatilho_pressionado = false
			
	if event.is_action_pressed(\"reload\"):
		arma_atual.recarregar()

	if !locked_controls:
		if event.is_action_pressed(\"run\"):
			if not is_crouching:
				SPEED = 8.5
			is_running = true
		elif event.is_action_released(\"run\"):
			if not is_crouching:
				SPEED = 5.0
			is_running = false
		if event.is_action_pressed(\"crouch\"):
			is_crouching = true
			SPEED = 5.0
			#$standing_colision.disabled=true
			#$crouched_collision.disabled=false
			camera_pivot.get_child(0).play(\"crouch\")
		elif event.is_action_released(\"crouch\"):
			is_crouching = false
			#$standing_colision.disabled=false
			#$crouched_collision.disabled=true
			camera_pivot.get_child(0).play(\"stand\")
			if Input.is_action_pressed(\"run\"):
				SPEED = 8.5
				is_running = true
			else:
				SPEED = 5.0
				is_running = false
		if GameManager.has_prototype:
			if event.is_action_pressed(\"change\") and GameManager.has_cube and !GameManager.has_gloves:
				feedback.exibir_texto_digitado(\"I can't return to past with cube in hands, will burn them!\")
				print(\"nao pode retornar ao passado com o cubo na mao, vai lhe queimar!\")
				return
			if event.is_action_pressed(\"change\"):
				animation_device.play(\"change\")
				if device.has_method(\"change_device\"):
					device.change_device()
				if glitch.has_method(\"change\"):
					locked_controls = true
					await glitch.change()
					flash.visible = true
					var level = self.get_parent()
					if level.has_method(\"change_epoch\"):
						level.change_epoch()
					item_view_manager.change_materials()
					await get_tree().create_timer(0.2).timeout
					flash.visible = false
					await get_tree().create_timer(0.5).timeout
					animation_device.play_backwards(\"change\")
					locked_controls = false
		if event is InputEventMouseButton:
			Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
			
	if event.is_action_pressed(\"pause\"):
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
		if mouse_view and !ui_open:
			if obj.has_method(\"exit_pc\"):
				obj.exit_pc(self)
			if obj.has_method(\"exit\"):
				obj.exit(self)
			if obj.has_method(\"exit_interact\"):
				obj.exit_interact(self)
		#if Input.is_action_just_pressed(\"right_click\"):
			#drop_item()
			
func _physics_process(delta: float) -> void:
	if !locked_controls:
		if Input.mouse_mode != Input.MOUSE_MODE_CAPTURED:
			return
		check_for_interactable_pickable()
		if not is_on_floor():
			velocity += get_gravity() * delta

		if Input.is_action_just_pressed(\"ui_accept\") and is_on_floor():
			velocity.y = JUMP_VELOCITY

		var input_dir := Input.get_vector(\"move_left\", \"move_right\", \"move_forward\", \"move_backwards\")
		var direction :Vector3= (camera_pivot.transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()
		if direction:
			#camera_anim_player.play(\"camera_walking\")
			velocity.x = direction.x * SPEED
			velocity.z = direction.z * SPEED
		else:
			#camera_anim_player.play(\"camera_idle\")
			velocity.x = move_toward(velocity.x, 0, SPEED)
			velocity.z = move_toward(velocity.z, 0, SPEED)

		move_and_slide()
		check_interaction()

func atualizar_ui_inventario() -> void:

	for i in range(botoes_carregadores.size()):

		var botao = botoes_carregadores[i]

		if i < inventario_carregadores.size():

			var carregador = inventario_carregadores[i]

			botao.visible = true

			botao.text = (
				WeaponTypes.nome_tipo(carregador.tipo_arma) + \"\\n\" +
				str(carregador.current_capacity) + \" / \" +
				str(carregador.capacity) + \"\\n\" +
				str(carregador.massa_gramas) + \" g\"
			)

		else:
			botao.visible = false

	if arma_atual != null:
		progress_bar.text = (
			str(arma_atual.municao_atual) + \"/\" +
			str(arma_atual.capacidade_arma)
		)

		label.text = WeaponTypes.nome_tipo(arma_atual.tipo_carregador)

const MAX_CARREGADORES = 4

func coletar_carregador(carregador):
	# Procura um carregador igual
	for carregador_inventario in inventario_carregadores:
		if (
			carregador_inventario.tipo_arma == carregador.tipo_arma
			and is_equal_approx(
				carregador_inventario.massa_gramas,
				carregador.massa_gramas
			)
		):
			# Soma a munição
			carregador_inventario.current_capacity += carregador.current_capacity

			 #Não ultrapassa a capacidade máxima
			carregador_inventario.current_capacity = min(
				carregador_inventario.current_capacity,
				carregador_inventario.capacity
			)

			 # Apenas esconde o carregador coletado
			carregador.visible = false
			atualizar_ui_inventario()

			print(\"Carregador agrupado!\")
			return

	# Se não encontrou igual, verifica os 4 slots
	if inventario_carregadores.size() >= MAX_CARREGADORES:
		print(\"Inventário cheio!\")
		return

	# Adiciona como novo slot
	inventario_carregadores.append(carregador)
	carregador.visible = false

	atualizar_ui_inventario()

	print(\"Novo carregador adicionado!\")

func remover_carregadores_vazios():
	for i in range(inventario_carregadores.size() - 1, -1, -1):
		var carregador = inventario_carregadores[i]

		if carregador.current_capacity <= 0:
			if arma_atual.carregador_equipado == carregador:
				arma_atual.carregador_equipado = null

			inventario_carregadores.remove_at(i)
			carregador.queue_free()

	atualizar_ui_inventario()

func tipo_carregador_existe(carragador):
	for c in inventario_carregadores:
		if c.get_tipo_carregador == carragador.get_tipo_carregador:
			c.current_capacity += carragador.current_capacity
			return true
	return false

func selecionar_carregador(indice: int):
	if indice < 0 or indice >= inventario_carregadores.size():
		return

	var carregador = inventario_carregadores[indice]
	arma_atual.tentar_equipar_carregador(carregador)
	botoes_carregadores[indice].grab_focus()
func check_for_interactable_pickable():

	if not ray.is_colliding():
		return
	
	if ray.is_colliding():
		obj = ray.get_collider()
		
		
		if obj == null:
			return
		var weapon = obj.get_parent()
		if weapon.is_in_group(\"weapon\"):
			if Input.is_action_just_pressed(\"change\"):
				trocar_arma_com_chao(weapon)
			return
		var carregador = obj.get_parent().get_parent()

		if carregador.has_method(\"get_tipo_carregador\"):
			if Input.is_action_just_pressed(\"change\"):
				if inventario_carregadores.size() < 4:
					coletar_carregador(carregador)
				else:
					print(\"inventario cheio\")
		if obj == null:
			return
		if obj.is_in_group(\"Interactable\"):
			crosshair.set_active(true)
			if obj.has_method(\"toggle_drawer\"):
				if Input.is_action_just_pressed(\"interact\"):
					obj.toggle_drawer()
			if obj.has_method(\"anim_handler\"):
				if Input.is_action_just_pressed(\"left_click\"):
					camera.current = false
					await obj.anim_handler(self)
					camera.current = true
			if obj.has_method(\"anim_handler_terminal\"):
				if Input.is_action_just_pressed(\"left_click\"):
					camera.current = false
					await obj.anim_handler_terminal(self)
			if obj.has_method(\"run_anim\"):
				if Input.is_action_just_pressed(\"left_click\"):
					await obj.run_anim(self)
			if obj.has_method(\"colect\"):
				if Input.is_action_just_pressed(\"left_click\"):
					obj.colect()
			if obj.has_method(\"pick_cube\"):
				if Input.is_action_just_pressed(\"left_click\"):
					obj.pick_cube(self)
			if obj.has_method(\"open\"):
				if Input.is_action_just_pressed(\"change\"):
					obj.open()
			if obj.has_method(\"picked\"):
				if Input.is_action_just_pressed(\"left_click\"):
					obj.picked()
			if obj.has_method(\"interact\"):
				if Input.is_action_just_pressed(\"left_click\"):
					obj.interact(self)
			if obj.has_method(\"acess_pc\"):
				if Input.is_action_just_pressed(\"left_click\"):
						obj.acess_pc(self)
			if obj.has_method(\"access_pc_present\"):
				if Input.is_action_just_pressed(\"left_click\"):
					if GameManager.has_energy:
						obj.access_pc_present(self)
			if obj.has_method(\"pick_docs\"):
				if Input.is_action_just_pressed(\"left_click\"):
						obj.pick_docs(self)

		else:
			crosshair.set_active(false)
		if obj.is_in_group(\"Pickable\"):
			pass
			#print(str(obj) + \"pickable\")
			#crosshair.get_child(0).set_active(true)
		if obj.has_method(\"pick_item\"):
			if Input.is_action_just_pressed(\"left_click\"):
				obj.pick_item()

	else:
		crosshair.set_active(false)

func hold_item(item_id):

	current_item = item_id

	for item in held_items.values():
		item.visible = false

	if held_items.has(item_id):
		held_items[item_id].visible = true

func force_recover_item(item):
	print(\"Force recovery\")

	item.freeze = false
	item.visible = true
	item.state = item.State.WORLD

	item.global_position = hold_position.global_position
	item.linear_velocity = Vector3.ZERO
	item.angular_velocity = Vector3.ZERO

func toggle_crosshair():
	if crosshair.get_children()[0].has_method(\"toggle_visibility\"):
		crosshair.get_children()[0].toggle_visibility()

func pick_item(item: RigidBody3D):
	if held_item != null:
		return
	
	if item.item_id == \"cabinet_key\":
		#print(\"com energia\")
		#GameManager.has_energy = true
		GameManager.has_cabinet_key = true
	
	if item.item_id == \"cube\":
		GameManager.has_cube = true
		print(GameManager.has_cube)
		
	
	if item.item_id == \"fuse\":
		print(\"com fuse\")
		GameManager.has_fuse = true
	
	if item.item_id == \"key\":
		#print(\"sem energia\")
		#GameManager.has_energy = false
		GameManager.has_secret_key = true
	audio_stream_player_3d.play()
	held_items[item.item_id].visible = true
	
	held_item = item

	item.owner_player = self
	item.state = item.State.HELD
	#item.reparent(self.hold_position)
	item.freeze = true
	item.visible = false
	item.sleeping = true

	item.freeze = true
	item.visible = false
	item.linear_velocity = Vector3.ZERO
	item.angular_velocity = Vector3.ZERO

func drop_item():
	if held_item == null:
		return
	
	var item = held_item
	
	#print(item)
	if item.item_id == \"cabinet_key\":
		#print(\"sem energia\")
		#GameManager.has_energy = false
		GameManager.has_cabinet_key = false
	
	if item.item_id == \"cube\":
		GameManager.has_cube = false
		print(GameManager.has_cube)
		
	
	if item.item_id == \"fuse\":
		print(\"com fuse\")
		GameManager.has_fuse = false
	
	if item.item_id == \"key\":
		#print(\"sem energia\")
		#GameManager.has_energy = false
		GameManager.has_secret_key = false

	#item.reparent(get_tree().current_scene)
	item.freeze = false
	item.visible = true
	item.sleeping = false
	
	audio_stream_player_3d.play()
	held_items[item.item_id].visible = false

	item.state = item.State.WORLD
	item.owner_player = null

	item.global_position = hold_position.global_position

	item.freeze = false
	item.visible = true

	var dir = -camera.global_transform.basis.z
	item.linear_velocity = Vector3.ZERO
	item.angular_velocity = Vector3.ZERO

	item.apply_impulse(dir * 2.5 + Vector3.UP * 0.5, Vector3.ZERO)
	
	item.axis_lock_angular_x = true
	item.axis_lock_angular_z = true
	item.axis_lock_angular_y = true
	
	await get_tree().create_timer(0.2).timeout

	item.axis_lock_angular_x = false
	item.axis_lock_angular_z = false
	item.axis_lock_angular_y = false

	held_item = null

#func trocar_arma(indice: int):
	#
	#if indice < 0 or indice >= armas.size():
		#return
#
	#if indice == indice_arma_atual:
		#return
	#
	#arma_atual.ativa = false
	#arma_atual.gatilho_pressionado = false
	#
	#arma_atual.visible = false
#
	#indice_arma_atual = indice
	#arma_atual = armas[indice_arma_atual]
#
	#arma_atual.ativa = false
	##arma_atual.visible = true
#
	#atualizar_ui_inventario()
	#
	#label.text = WeaponTypes.nome_tipo(arma_atual.tipo_carregador)
#
	#print(\"Arma atual: \", indice_arma_atual)

func atualizar_visual_arma() -> void:
	for view in armas_view:
		view.visible = false

	if arma_atual == null:
		return

	if arma_atual.tipo_carregador == WeaponTypes.MagazineType.PistolGlock:
		armas_view[0].visible = true

		arma_atual.muzzle = (
			$CameraPivot/Camera3D/HoldPosition/item_view_manager/gun_view
			.get_node(\"muzzle_ref\")
		)

	elif arma_atual.tipo_carregador == WeaponTypes.MagazineType.Rifle:
		armas_view[1].visible = true

		arma_atual.muzzle = (
			$CameraPivot/Camera3D/HoldPosition/item_view_manager/rifle_view
			.get_node(\"muzzle_ref\")
		)
	
	elif arma_atual.tipo_carregador == WeaponTypes.MagazineType.Shotgun:
		armas_view[2].visible = true

		arma_atual.muzzle = (
			$CameraPivot/Camera3D/HoldPosition/item_view_manager/shotgun_view
			.get_node(\"muzzle_ref\")
		)
		
	elif arma_atual.tipo_carregador == WeaponTypes.MagazineType.Pistol1911:
		armas_view[3].visible = true

		arma_atual.muzzle = (
			$CameraPivot/Camera3D/HoldPosition/item_view_manager/pistoll_1911_view
			.get_node(\"muzzle_ref\")
		)

	print(\"Arma atual: \", arma_atual)
	print(\"Muzzle: \", arma_atual.muzzle)

func trocar_arma_com_chao(arma_do_chao) -> void:
	if arma_do_chao == null:
		print(\"ERRO: arma_do_chao é null\")
		return

	if arma_do_chao == arma_atual:
		print(\"ERRO: arma do chão já é a arma atual\")
		return

	print(\"========== TROCA ==========\")
	print(\"Arma atual: \", arma_atual.name)
	print(\"Arma encontrada: \", arma_do_chao.name)

	var arma_antiga = arma_atual

	# Guarda posição da arma encontrada no chão
	var posicao_chao = arma_do_chao.global_position
	var rotacao_chao = arma_do_chao.global_rotation

	print(\"Posição da arma do chão: \", posicao_chao)

	# -------------------------
	# ARMA ATUAL VAI PARA O CHÃO
	# -------------------------

	arma_antiga.ativa = false
	arma_antiga.gatilho_pressionado = false
	arma_antiga.visible = true

	arma_antiga.global_position = posicao_chao
	arma_antiga.global_rotation = rotacao_chao
	arma_antiga.ativar_collision()

	# -------------------------
	# NOVA ARMA VIRA A ATUAL
	# -------------------------

	arma_atual = arma_do_chao

	arma_atual.player = self
	arma_atual.ativa = true
	arma_atual.gatilho_pressionado = false
	arma_atual.disable_collision()

	# Física escondida
	arma_atual.visible = false

	print(\"Nova arma atual: \", arma_atual.name)
	print(\"Tipo: \", WeaponTypes.nome_tipo(arma_atual.tipo_carregador))

	# Atualiza view e muzzle
	atualizar_visual_arma()

	# Atualiza UI
	atualizar_ui_inventario()

	print(\"Arma trocada!\")
	print(\"===========================\")
"

