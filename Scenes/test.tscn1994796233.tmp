[sub_resource type="GDScript" id="GDScript_5wyu1"]
resource_name = "era_manager"
script/source = "extends Node3D

@onready var era_past: Node3D = $EraPast
@onready var era_present: Node3D = $EraPresent

func change_era():
	era_present.change()
	era_past.change()
"

[sub_resource type="GDScript" id="GDScript_i3aeo"]
resource_name = "era_past"
script/source = "extends Node3D

@onready var csg_box_3d: CSGBox3D = $CSGBox3D

func change():
	csg_box_3d.visible = !csg_box_3d.visible
	csg_box_3d.use_collision = !csg_box_3d.use_collision
"

