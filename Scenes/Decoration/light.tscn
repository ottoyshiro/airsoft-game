[gd_scene format=3 uid="uid://b0vwmap2phgp"]

[sub_resource type="GDScript" id="GDScript_u7oeq"]
resource_name = "light"
script/source = "extends Node3D

@onready var animation_player: AnimationPlayer = $AnimationPlayer

func _ready() -> void:
	if !GameManager.is_on_past:
		run_light_loop()



func run_light_loop():
	while true:
		await get_tree().create_timer(1.0).timeout
		animation_player.play(\"change_era\")
		await get_tree().create_timer(4.0).timeout
"

