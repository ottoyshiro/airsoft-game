[sub_resource type="GDScript" id="GDScript_qc4db"]
resource_name = "test"
script/source = "extends Node3D

#@onready var encanacao: Node3D = $encanacao
@onready var era_manager: Node3D = $EraManager
@onready var player: CharacterBody3D = $Player
func change_epoch():
	#efeito de glitch
	#encanacao.visible = !encanacao.visible
	era_manager.change_era()
	GameManager._change() #so chama essa funcao aqui


func _on_area_3d_body_entered(body: Node3D) -> void:
	if body.is_in_group(\"player\"):
		player.shoot = false
		print(\"proibido\")



func _on_area_3d_body_exited(body: Node3D) -> void:
	if body.is_in_group(\"player\"):
		player.shoot = true
		print(\"podi\")
"

