[gd_scene format=3 uid="uid://c0qsvrq6n2bgd"]

[sub_resource type="GDScript" id="GDScript_bhunq"]
resource_name = "game_over"
script/source = "extends CanvasLayer

@onready var label: Label = $Control/HBoxContainer/VBoxContainer/Label2

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	update_scene()
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE


func update_scene():
	label.text = \"Enemies defeated: \" + str(GameManager.enemies_defeated) + \"/\" + str(GameManager.total_enemies)


func _on_button_pressed() -> void:
	self.get_tree().change_scene_to_packed(preload(\"res://airsoft_menu.tscn\"))
"

