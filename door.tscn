[gd_scene format=3 uid="uid://nbx7b8n7ebn7"]

[sub_resource type="GDScript" id="GDScript_0phs7"]
script/source = "extends Node3D

@onready var animation_player: AnimationPlayer = $AnimationPlayer
@onready var csg_porta: CSGBox3D = $CSGBox3D

func _ready() -> void:
	if csg_porta:
		# 1. Verifica se existe um material aplicado diretamente no CSG
		if csg_porta.material:
			csg_porta.material = csg_porta.material.duplicate()
			
		# 2. Se você usou material por sobreposição (Material Override), duplica ele também
		if csg_porta.material_override:
			csg_porta.material_override = csg_porta.material_override.duplicate()

func open():
	animation_player.play(\"open\")
"

