[sub_resource type="GDScript" id="GDScript_07qne"]
resource_name = "target"
script/source = "extends Node3D

@export_range(5, 20, 5) var hp_points = 5
@export_enum(\"blue\", \"green\", \"yellow\", \"red\") var color = \"blue\"
@export var door : Node3D

@onready var colors : Array[String] = [\"res://Assets/Materials/Terminal/red_light.tres\",
			\"res://Assets/Materials/Terminal/green_light.tres\"]
@onready var mesh_instance: MeshInstance3D = $MeshInstance3D2
@onready var label: MeshInstance3D = $MeshInstance3D3

func _ready() -> void:
	if label and label.mesh:
		label.mesh = label.mesh.duplicate()
	label.mesh.text = \"\"
	mesh_instance.set_surface_override_material(0, preload(\"res://Assets/Materials/Terminal/red_light.tres\"))

func take_damage(amount: int) -> void:
	hp_points -= amount
	print(\"Inimigo tomou tiro! HP restante: \", hp_points)
	label.mesh.text = str(hp_points)
	if hp_points <= 0:
		label.mesh.text = \"\"
		print(\"you killed\")
		mesh_instance.set_surface_override_material(0, preload(\"res://Assets/Materials/Terminal/green_light.tres\"))
		open_door()

func open_door():
	if door.has_method(\"open\"):
		door.open()
"

